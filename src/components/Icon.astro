  {name === 'material' && <><path d="m12 18 12-7 12 7-12 7zM12 25l12 7 12-7M12 32l12 6 12-6"/><circle cx="35" cy="14" r="5"/></>}
  {name === 'warranty' && <><path d="M24 10 36 15v9c0 7-5 11-12 14-7-3-12-7-12-14v-9z"/><path d="m18 25 4 4 8-9"/><path d="M18 17h12"/></>}
</svg>
