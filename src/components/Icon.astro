  {name === 'design' && <><path d="m11 23 13-11 13 11v13H11z"/><path d="M19 36V25h9v11M30 16l5-4 3 3-4 5"/></>}
  {name === 'production' && <><path d="M12 34h25M16 31l4-8 7 3 5-4 7 3"/><circle cx="24" cy="15" r="4"/><path d="m21 19-5 7 8 3 5-5M12 34v-5M37 34v-5"/></>}
  {name === 'install' && <><path d="M11 34h26M15 34v-7h8v-7h8v-7h5"/><circle cx="15" cy="14" r="3"/><path d="m15 17 3 8 7 3M17 23l-5 5"/></>}
  {name === 'custom' && <><rect x="13" y="11" width="22" height="26" rx="2"/><path d="M19 31l2-7 9-9 4 4-9 9zM19 31l5-2"/></>}
